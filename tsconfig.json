{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": [
    "packages/**",
    "pharn/**",
    "node_modules/**",
    "**/node_modules/**",
    "**/dist/**",
    "coverage/**",
    ".pharn/**",
    "runs/**"
  ]
}
