{
  "name": "argus",
  "version": "0.0.1",
  "description": "All-seeing runtime diagnostics for Node.js. Event loop lag, memory, GC, stream backpressure and request tracing from a single require — zero dependencies, no collector service.",
  "keywords": [
    "nodejs",
    "diagnostics",
    "observability",
    "event-loop",
    "memory",
    "gc",
    "tracing",
    "profiling",
    "apm"
  ],
  "homepage": "https://github.com/pharn-dev/argus#readme",
  "bugs": {
    "url": "https://github.com/pharn-dev/argus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pharn-dev/argus.git"
  },
  "license": "Apache-2.0",
  "author": "Przemek Galarowicz",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "exports": {
    "./agent": {
      "import": {
        "types": "./dist/esm/agent/index.d.ts",
        "default": "./dist/esm/agent/index.js"
      },
      "require": {
        "types": "./dist/cjs/agent/index.d.ts",
        "default": "./dist/cjs/agent/index.js"
      }
    },
    "./collector": {
      "import": {
        "types": "./dist/esm/collector/index.d.ts",
        "default": "./dist/esm/collector/index.js"
      },
      "require": {
        "types": "./dist/cjs/collector/index.d.ts",
        "default": "./dist/cjs/collector/index.js"
      }
    },
    "./analyzer": {
      "import": {
        "types": "./dist/esm/analyzer/index.d.ts",
        "default": "./dist/esm/analyzer/index.js"
      },
      "require": {
        "types": "./dist/cjs/analyzer/index.d.ts",
        "default": "./dist/cjs/analyzer/index.js"
      }
    },
    "./dashboard": {
      "import": {
        "types": "./dist/esm/dashboard/index.d.ts",
        "default": "./dist/esm/dashboard/index.js"
      },
      "require": {
        "types": "./dist/cjs/dashboard/index.d.ts",
        "default": "./dist/cjs/dashboard/index.js"
      }
    },
    "./plugin-runner": {
      "import": {
        "types": "./dist/esm/plugin-runner/index.d.ts",
        "default": "./dist/esm/plugin-runner/index.js"
      },
      "require": {
        "types": "./dist/cjs/plugin-runner/index.d.ts",
        "default": "./dist/cjs/plugin-runner/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:pins": "node scripts/check-action-pins.mjs",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
