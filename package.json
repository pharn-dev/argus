{
  "name": "argus",
  "version": "0.0.1",
  "description": "All-seeing runtime diagnostics for Node.js. Event loop lag, memory, GC, stream backpressure and request tracing from a single require — zero dependencies, no collector service.",
  "keywords": [
    "nodejs"
  ],
  "homepage": "https://github.com/pharn-dev/pharn-oss#readme",
  "bugs": {
    "url": "https://github.com/pharn-dev/pharn-oss/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pharn-dev/pharn-oss.git"
  },
  "license": "Apache-2.0",
  "author": "Przemek Galarowicz",
  "type": "commonjs",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:packages": "tsc --build -p tsconfig.packages.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
